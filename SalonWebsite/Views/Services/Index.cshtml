@model IEnumerable<SalonWebsite.Models.Service>

@{
    ViewBag.Title = "Services";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Salon Services</h2>
            <p class="text-muted mb-0">
                Manage all the services offered by your salon.
            </p>
        </div>

        @Html.ActionLink(
                 "+ Add New Service",
                 "Create",
                 "Services",
                 null,
                 new { @class = "btn btn-warning btn-lg" })

    </div>

    @if (!Model.Any())
    {
        <div class="empty-state text-center shadow-sm p-5">

            <i class="bi bi-scissors display-1 text-warning"></i>

            <h3 class="mt-3">
                No Services Yet
            </h3>

            <p class="text-muted">
                Start by adding your first salon service.
            </p>

            @Html.ActionLink(
                     "Add First Service",
                     "Create",
                     "Services",
                     null,
                     new { @class = "btn btn-success btn-lg" })

        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card service-card shadow-sm h-100">

                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="@Url.Content(item.Image)"
                                 class="card-img-top service-image" />
                        }
                        else
                        {
                            <img src="~/Content/images/no-image.jpg"
                                 class="card-img-top service-image" />
                        }

                        <div class="card-body">

                            <h4 class="fw-bold">
                                @item.Name
                            </h4>

                            <p class="text-muted">
                                @item.Description
                            </p>

                            <h5 class="text-warning fw-bold">
                                R @item.Price
                            </h5>

                        </div>

                        <div class="card-footer bg-white border-0">

                            @Html.ActionLink("Edit", "Edit",
                                     new { id = item.ServiceId },
                                     new { @class = "btn btn-outline-warning btn-sm" })

                            @Html.ActionLink("Details", "Details",
                                     new { id = item.ServiceId },
                                     new { @class = "btn btn-outline-primary btn-sm" })

                            @Html.ActionLink("Delete", "Delete",
                                     new { id = item.ServiceId },
                                     new { @class = "btn btn-outline-danger btn-sm" })

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>