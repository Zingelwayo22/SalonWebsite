@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-dashboard">

    <!-- Header -->
    <div class="dashboard-header">
        <div>
            <h1>Salon Admin Dashboard</h1>
            <p>Manage everything displayed on your salon website.</p>
        </div>

        <a href="@Url.Action("Index", "Home")"
           class="btn btn-dark">
            <i class="bi bi-globe2"></i>
            View Website
        </a>
    </div>


    <!-- Management Cards -->
    <div class="dashboard-grid">

        <!-- About -->
        <div class="dashboard-card">

            <div class="dashboard-icon">
                <i class="bi bi-file-text"></i>
            </div>

            <h3>About</h3>

            <p>
                Edit the information about your salon.
            </p>

            <a href="@Url.Action("Index", "About")"
               class="dashboard-button">
                <i class="bi bi-pencil"></i>
                Edit About
            </a>

        </div>


        <!-- Services -->
        <div class="dashboard-card">

            <div class="dashboard-icon">
                <i class="bi bi-scissors"></i>
            </div>

            <h3>Services</h3>

            <p>
                Add, edit and remove salon services.
            </p>

            <a href="@Url.Action("Index", "Services")"
               class="dashboard-button">
                <i class="bi bi-gear"></i>
                Manage Services
            </a>

        </div>


        <!-- Gallery -->
        <div class="dashboard-card">

            <div class="dashboard-icon">
                <i class="bi bi-images"></i>
            </div>

            <h3>Gallery</h3>

            <p>
                Add and remove photos from your salon gallery.
            </p>

            <a href="@Url.Action("Index", "Gallery")"
               class="dashboard-button">
                <i class="bi bi-images"></i>
                Manage Gallery
            </a>

        </div>


        <!-- Contact -->
        <div class="dashboard-card">

            <div class="dashboard-icon">
                <i class="bi bi-telephone"></i>
            </div>

            <h3>Contact</h3>

            <p>
                Update your phone, email, address and contact details.
            </p>

            <a href="@Url.Action("Index", "Contact")"
               class="dashboard-button">
                <i class="bi bi-pencil"></i>
                Edit Contact
            </a>

        </div>


        <!-- Website Settings -->
        <div class="dashboard-card">

            <div class="dashboard-icon">
                <i class="bi bi-gear"></i>
            </div>

            <h3>Website Settings</h3>

            <p>
                Change your salon name and website settings.
            </p>

            <a href="@Url.Action("Index", "WebsiteSettings")"
               class="dashboard-button">
                <i class="bi bi-sliders"></i>
                Settings
            </a>

        </div>


        <!-- Website Preview -->
        <div class="dashboard-card">

            <div class="dashboard-icon">
                <i class="bi bi-display"></i>
            </div>

            <h3>Website Preview</h3>

            <p>
                View the public website as your customers see it.
            </p>

            <a href="@Url.Action("Index", "Home")"
               class="dashboard-button dark">
                <i class="bi bi-eye"></i>
                View Website
            </a>

        </div>

    </div>

</div>